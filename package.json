{
  "name": "visubly-desktop",
  "version": "0.1.0",
  "description": "Desktop UI shell for Visubly video download and Vietnamese subtitle workflows.",
  "main": "src/main/main.js",
  "private": true,
  "author": "Visubly",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node scripts/check-app.js",
    "package:win": "electron-builder --win nsis",
    "package:mac": "electron-builder --mac dmg"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.visubly.studio",
    "productName": "Visubly Studio",
    "afterPack": "scripts/after-pack.js",
    "files": [
      "src/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/@ffmpeg-installer/ffmpeg/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "script": "build/installer.nsi"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video"
    }
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "bonjour-service": "^1.2.1",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  }
}
