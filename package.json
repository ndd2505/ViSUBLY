{
  "name": "visubly-desktop",
  "productName": "Visubly Studio",
  "version": "1.1.1",
  "description": "Desktop UI shell for Visubly video download and Vietnamese subtitle workflows.",
  "main": "src/main/main.js",
  "private": true,
  "author": "Visubly",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "check": "node scripts/check-app.js",
    "build:engine": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-downloader.ps1",
    "package:win": "npm run build:engine && electron-builder --win",
    "package:mac": "electron-builder --mac dmg",
    "package:win:ci": "npm run build:engine && electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "app.visubly.studio",
    "productName": "Visubly Studio",
    "copyright": "© 2026 Visubly",
    "afterPack": "scripts/after-pack.js",
    "files": [
      "src/**/*",
      "build/icon.ico",
      "build/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "browser-extension/chrome",
        "to": "browser-extension/chrome"
      }
    ],
    "asarUnpack": [
      "**/node_modules/@ffmpeg-installer/**/*"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "dist-engine/visubly-downloader.exe",
          "to": "engine/visubly-downloader.exe"
        }
      ],
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Visubly Studio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "multiLanguageInstaller": true,
      "installerLanguages": [
        "en_US",
        "vi_VN"
      ],
      "artifactName": "ViSUBLY-Setup-${version}.${ext}",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp"
    },
    "portable": {
      "artifactName": "ViSUBLY-Portable-${version}.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.video"
    },
    "fileAssociations": [
      {
        "ext": [
          "mp4",
          "m4v",
          "mkv",
          "webm",
          "mov"
        ],
        "name": "ViSUBLY.Video",
        "description": "Video",
        "role": "Viewer",
        "icon": "icon"
      }
    ]
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "bonjour-service": "^1.2.1",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "qrcode": "^1.5.4",
    "ws": "^8.21.0"
  }
}
